# Existing Toolkit compose network. Check with: docker network ls
SHARELATEX_NETWORK=overleaf_default

# Mongo and Redis service names on the Toolkit network.
MONGO_URL=mongodb://mongo/sharelatex
REDIS_URL=redis://redis:6379

# Personal trusted mode: no local Git username/token is required.
AUTH_MODE=trusted

# Generate long random values. Do not commit deploy/.env.
ADAPTER_TOKEN=replace_with_random_adapter_token
GIT_TOKEN=
INTERNAL_HOOK_TOKEN=replace_with_random_hook_token

# Optional: used for GitHub/Gitee remotes when credentials are not embedded in the URL.
GITHUB_TOKEN=

# Optional CORS allow-list for the editor panel. Leave empty to reflect the
# caller's Origin (works with any host/port, e.g. http://203.0.113.10:2333).
# Narrow it to an exact origin once the deployment is stable, for example:
#   CORS_ORIGINS=https://overleaf.example.com
CORS_ORIGINS=

# Optional: host interface and port the bridge publishes for local git CLI use.
# Keep 127.0.0.1 when a reverse proxy fronts the container; the browser panel
# talks to the container through the proxy and does not need this port.
# GIT_BRIDGE_BIND=127.0.0.1
# GIT_BRIDGE_PORT=18081

# Host path of the ShareLaTeX filestore "fs" directory. Uploaded binaries live
# there as "<project-id>_<file-id>", and the adapter mounts it read/write so
# images, PDFs and fonts can travel through Git. Detect it with:
#   docker inspect sharelatex --format \
#     '{{range .Mounts}}{{if eq .Destination "/var/lib/sharelatex"}}{{.Source}}{{end}}{{end}}'
# then append /data/user_files.
USER_FILES_PATH=/root/overleaf-toolkit/data/overleaf/data/user_files

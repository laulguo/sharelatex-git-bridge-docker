# Existing Toolkit compose network. Check with: docker network ls
SHARELATEX_NETWORK=overleaf_default

# Mongo and Redis service names on the Toolkit network.
MONGO_URL=mongodb://mongo/sharelatex
REDIS_URL=redis://redis:6379

# ShareLaTeX site-admin user ObjectId that owns the test/project access.
GIT_USER_ID=replace_with_sharelatex_user_object_id

# Generate long random values. Do not commit deploy/.env.
ADAPTER_TOKEN=replace_with_random_adapter_token
GIT_TOKEN=replace_with_random_git_token
INTERNAL_HOOK_TOKEN=replace_with_random_hook_token

# Optional: used for GitHub/Gitee remotes when credentials are not embedded in the URL.
GITHUB_TOKEN=
